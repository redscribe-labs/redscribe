DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Reverse proxy / TLS (see README's "Reverse proxy + TLS" section).
# Your domain — the tailnet hostname if using the tailscale docker-compose
# profile, or your own domain for a BYO cert. Leave unset for nginx's "_"
# catch-all default.
# NOTE on the tailscale profile: the hostname you put here becomes
# publicly visible (not the app itself, just the name) — see the warning
# in certs/README.md before choosing it.
NGINX_SERVER_NAME=

# Gunicorn worker count. Leave unset to auto-size to (2 * cpu cores) + 1
# at container startup (see entrypoint.sh) — set explicitly to override.
GUNICORN_WORKERS=

POSTGRES_DB=redscribe
POSTGRES_USER=redscribe
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# "google" | "microsoft" | "" (empty = local auth only, Phase 1 default)
OAUTH_PROVIDER=

# Consultancies are single-tenant per instance: OAuth sign-in is locked to
# exactly one provider (above) and one email domain (below). Anyone
# authenticating with a valid provider account outside this domain is
# rejected before an account is created. Required whenever OAUTH_PROVIDER
# is set.
OAUTH_ALLOWED_DOMAIN=

# Required only when OAUTH_PROVIDER=google. Create at
# https://console.cloud.google.com/apis/credentials — an OAuth 2.0 Client
# ID of type "Web application", with an authorized redirect URI of
# https://<your-domain>/accounts/social/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Required only when OAUTH_PROVIDER=microsoft. Create at
# https://entra.microsoft.com under App registrations, with a redirect
# URI of https://<your-domain>/accounts/social/microsoft/login/callback/
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Leave as "organizations" unless the consultancy needs a specific Entra
# ID tenant restricted at the login-screen level too, in which case set
# it to that tenant's ID (a stricter belt-and-braces alongside
# OAUTH_ALLOWED_DOMAIN, not a replacement for it).
MICROSOFT_OAUTH_TENANT_ID=organizations

# Instance root key for the per-engagement keystore. Generate with:
#   python manage.py generate_root_key
# Under docker-compose, this is mounted as a Docker secret instead — see
# secrets/README.md — and this var is left unset. Only set it here for a
# non-Docker/bare-metal run or CI. Never commit the real value; treat it
# like the master key it is.
REDSCRIBE_ROOT_KEY=

LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_SECONDS=86400
SUPERADMIN_RATE_LIMIT_WINDOW_SECONDS=60
SUPERADMIN_RATE_LIMIT_MAX_ATTEMPTS=10

# Checks new passwords against HaveIBeenPwned's breach corpus (k-anonymity
# API — only a 5-char hash prefix ever leaves this instance). Set to false
# for air-gapped deployments with no outbound internet access.
PWNED_PASSWORD_CHECK_ENABLED=true

# Email (password reset links + change notifications). Leave EMAIL_HOST
# blank to use the console backend (emails are printed to the app log) —
# fine for local/dev; set real SMTP creds for production.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL="RedScribe <no-reply@redscribe.local>"

# How long a password reset link stays valid, in seconds (default: 1 hour).
PASSWORD_RESET_TIMEOUT_SECONDS=3600
